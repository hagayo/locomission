DATABASE_URL=postgresql://locomission:REPLACE_PASSWORD@localhost:5432/locomission
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=REPLACE_IN_LOCAL_ENV_ONLY

# Clerk backend: obtain these values from YOUR Clerk application Dashboard.
# Never commit actual secrets or passwords.
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_OWN_SECRET
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_OWN_PEM\n-----END PUBLIC KEY-----"
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Frontend separately uses mobile/.env with VITE_CLERK_PUBLISHABLE_KEY.

# Dangerous development-only bypass. Do not enable on a public host.
LOCOMISSION_DEV_MODE=false
LOCOMISSION_DEV_PLAYER_ID=REPLACE_LOCAL_TEST_UUID

# Bound concurrent model calls per API worker (1..32); default 4.
# Use central rate limiting if running multiple API worker processes.
LOCOMISSION_MAX_VISION_CONCURRENCY=4

# local | staging | production. Set staging on Render initially.
LOCOMISSION_ENV=local

# Provisional pilot budgets (per player, shared across sessions).
# Every OpenAI attempt is charged to the limit, including network failures.
LOCOMISSION_REQUESTS_PER_MINUTE=360
LOCOMISSION_SESSIONS_PER_HOUR=30
LOCOMISSION_PROOFS_PER_DAY=20
LOCOMISSION_GLOBAL_PROOFS_PER_DAY=250
